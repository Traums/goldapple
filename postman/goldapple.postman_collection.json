            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "По умолчанию товар 1, сыворотка с витамином C."
          }
        },
        {
          "name": "Создать товар",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Создан', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('productId', String(body.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LL-CREAM-50\",\n  \"name\": \"Крем для лица, 50 мл\",\n  \"brand\": \"Lumière Lab\",\n  \"category\": \"SKINCARE\",\n  \"price\": 1290.00,\n  \"stockQuantity\": 12,\n  \"status\": \"ACTIVE\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=900&q=80\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Ответ 201. Id записывается в productId. Повтор артикула даёт 409 PRODUCT_SKU_TAKEN."
          }
        },
        {
          "name": "Изменить товар",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"LL-CREAM-50\",\n  \"name\": \"Крем для лица, 40 мл\",\n  \"brand\": \"Lumière Lab\",\n  \"category\": \"SKINCARE\",\n  \"price\": 990.50,\n  \"stockQuantity\": 0,\n  \"status\": \"OUT_OF_STOCK\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=900&q=80\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Тело передаётся целиком. Запускайте после «Создать товар», иначе изменится товар из productId, по умолчанию сыворотка."
          }
        }
